{
  "permissions": {
    "allow": [
      "Read",
      "Write",
      "Edit",
      "Glob",
      "Grep",
      "WebSearch",
      "WebFetch",
      "Bash"
    ],
    "deny": [
      "Bash(gh pr merge *)",
      "Bash(gh pr review *)",
      "Bash(gh api -X PUT repos/*/pulls/*/merge*)",
      "Bash(gh api --method PUT repos/*/pulls/*/merge*)",
      "Bash(git push * main)",
      "Bash(git push origin main*)",
      "Bash(git push --force*)",
      "Bash(git push -f *)",
      "Bash(rm -rf /*)",
      "Write(CLAUDE.md)",
      "Edit(CLAUDE.md)",
      "Write(prompts/**)",
      "Edit(prompts/**)",
      "Write(knowledge/schema/**)",
      "Edit(knowledge/schema/**)",
      "Write(scripts/**)",
      "Edit(scripts/**)",
      "Write(.github/**)",
      "Edit(.github/**)",
      "Write(.claude/**)",
      "Edit(.claude/**)"
    ]
  }
}
