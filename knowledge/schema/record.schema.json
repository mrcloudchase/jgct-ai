{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "JGCT knowledge base record: one source, read in full or, when full text cannot be had, from its abstract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "source_id",
    "source_type",
    "source_tier",
    "source_url",
    "retrieved_on",
    "evidence_basis",
    "full_text_source",
    "title",
    "year",
    "study_type",
    "key_findings",
    "relevance_to_jgct",
    "review_status"
  ],
  "properties": {
    "source_id": {
      "type": "string",
      "description": "pmid number, DOI, abstract number, or 12-char sha1 of the URL"
    },
    "source_type": {
      "type": "string",
      "enum": [
        "pmid",
        "doi",
        "abstract",
        "url"
      ]
    },
    "source_tier": {
      "type": "string",
      "enum": [
        "peer_reviewed",
        "guideline",
        "registry",
        "preprint",
        "conference_abstract",
        "database",
        "organization",
        "other"
      ]
    },
    "source_url": {
      "type": "string",
      "pattern": "^https?://"
    },
    "retrieved_on": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "evidence_basis": {
      "type": "string",
      "enum": [
        "full_text",
        "abstract"
      ],
      "description": "What the record rests on. full_text: the complete source was read start to finish. abstract: only the abstract (and title, metadata) was read, because no open route to the full text exists; everything in the record comes from that abstract, and the site marks every citation of it. Replace with a full_text record as soon as the full text can be read."
    },
    "full_text_source": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^(https?://|PMC\\d+|file:)",
      "description": "Where the full text was read from: a PMC ID, URL, or file. Required (non-null) when evidence_basis is full_text; null when evidence_basis is abstract. For a conference abstract, trial-registry entry or database query the complete item is the full text."
    },
    "abstract_source": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^https?://",
      "description": "Where the abstract was read (PubMed, publisher page, Crossref). Required when evidence_basis is abstract."
    },
    "language": {
      "type": [
        "string",
        "null"
      ],
      "default": "en"
    },
    "pmid": {
      "type": [
        "string",
        "null"
      ]
    },
    "doi": {
      "type": [
        "string",
        "null"
      ]
    },
    "pmcid": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^PMC\\d+$",
      "description": "PubMed Central ID, when the article is in PMC"
    },
    "title": {
      "type": "string",
      "minLength": 3
    },
    "journal": {
      "type": [
        "string",
        "null"
      ]
    },
    "year": {
      "type": "integer",
      "minimum": 1900,
      "maximum": 2100
    },
    "first_author": {
      "type": [
        "string",
        "null"
      ]
    },
    "study_type": {
      "type": "string",
      "enum": [
        "case_report",
        "case_series",
        "cohort",
        "genomic",
        "review",
        "meta_analysis",
        "trial",
        "registry",
        "guideline",
        "database_entry",
        "other"
      ]
    },
    "tumor_site": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "ovary",
        "testis",
        "both",
        "other",
        null
      ],
      "description": "Site of the JGCT the source is about. 'both' for sources covering ovarian and testicular tumors; null if not stated or not applicable."
    },
    "n_jgct_patients": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "age_range": {
      "type": [
        "string",
        "null"
      ]
    },
    "alterations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "gene",
          "alteration"
        ],
        "properties": {
          "gene": {
            "type": "string"
          },
          "alteration": {
            "type": "string"
          },
          "frequency": {
            "type": [
              "string",
              "null"
            ]
          },
          "notes": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "treatments": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "regimen"
        ],
        "properties": {
          "regimen": {
            "type": "string"
          },
          "setting": {
            "type": [
              "string",
              "null"
            ]
          },
          "n": {
            "type": [
              "integer",
              "null"
            ]
          },
          "outcome": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "presentation": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Clinical presentation features reported, e.g. precocious puberty, abdominal mass"
    },
    "key_findings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "relevance_to_jgct": {
      "type": "string",
      "minLength": 10
    },
    "conflicts_with": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "record file stems this disagrees with"
    },
    "overlaps_with": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "record file stems that report some of the same patients (do not add their counts together)"
    },
    "superseded_by": {
      "type": [
        "string",
        "null"
      ]
    },
    "retracted": {
      "type": "boolean",
      "default": false
    },
    "notes": {
      "type": [
        "string",
        "null"
      ]
    },
    "review_status": {
      "type": "string",
      "enum": [
        "draft",
        "reviewed"
      ]
    },
    "reviewed_by": {
      "type": [
        "string",
        "null"
      ]
    },
    "reviewed_on": {
      "type": [
        "string",
        "null"
      ]
    },
    "patients": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "site",
          "outcome"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "label of the patient within this source (case number or '1')"
          },
          "sex": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "F",
              "M",
              "other",
              null
            ]
          },
          "age_years": {
            "type": [
              "number",
              "null"
            ],
            "description": "age at diagnosis in years (infants as a fraction); null if not stated"
          },
          "site": {
            "type": "string",
            "enum": [
              "ovary",
              "testis",
              "other"
            ]
          },
          "stage": {
            "type": [
              "string",
              "null"
            ],
            "description": "FIGO stage as the source states it (IA, IB, IC, IC1, IC2, IC3, II, IIA, IIB, IIC, III, IIIA, IIIB, IIIC, IV); null if not stated"
          },
          "stage_system": {
            "type": [
              "string",
              "null"
            ],
            "description": "FIGO 2014, FIGO (pre-2014), COG, Wollner, or null"
          },
          "rupture": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "none",
              "intraoperative",
              "preoperative",
              "unknown",
              null
            ]
          },
          "malignant_ascites": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "mitoses_per_10hpf": {
            "type": [
              "number",
              "null"
            ]
          },
          "tumor_size_cm": {
            "type": [
              "number",
              "null"
            ]
          },
          "presentation": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "precocious_puberty",
                "virilization",
                "abdominal_pain",
                "abdominal_mass_or_distension",
                "menstrual_change",
                "torsion",
                "rupture_or_hemoperitoneum",
                "ascites",
                "scrotal_mass",
                "incidental",
                "pregnancy",
                "other"
              ]
            }
          },
          "syndrome": {
            "type": [
              "string",
              "null"
            ]
          },
          "surgery": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "unilateral_salpingo-oophorectomy",
              "oophorectomy",
              "cystectomy_or_enucleation",
              "cystectomy_then_completion",
              "radical",
              "orchiectomy",
              "testis_sparing",
              "biopsy_only",
              "other",
              "unknown",
              null
            ]
          },
          "chemotherapy": {
            "type": [
              "string",
              "null"
            ],
            "description": "regimen as stated, or 'none'; null if not stated"
          },
          "chemo_setting": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "adjuvant",
              "neoadjuvant",
              "relapse",
              "none",
              "unknown",
              null
            ]
          },
          "relapse": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "relapse_months": {
            "type": [
              "number",
              "null"
            ]
          },
          "outcome": {
            "type": "string",
            "enum": [
              "NED",
              "AWD",
              "DOD",
              "died_other",
              "unknown"
            ],
            "description": "NED no evidence of disease at last follow-up; AWD alive with disease; DOD died of disease; died_other died of another cause"
          },
          "follow_up_months": {
            "type": [
              "number",
              "null"
            ]
          },
          "notes": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "description": "Patient-level extraction for case reports and small series, one entry per JGCT patient the source describes individually, copied from the text; feeds analyses/. Only from sources read in full unless the abstract states every field used."
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "evidence_basis": {
            "const": "full_text"
          }
        }
      },
      "then": {
        "properties": {
          "full_text_source": {
            "type": "string"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "evidence_basis": {
            "const": "abstract"
          }
        }
      },
      "then": {
        "properties": {
          "full_text_source": {
            "type": "null"
          },
          "abstract_source": {
            "type": "string"
          }
        },
        "required": [
          "abstract_source"
        ]
      }
    }
  ]
}
